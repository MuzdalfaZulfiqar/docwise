# --- core ---
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# --- LLM chain: provider:model, comma separated, tried in order (fallbacks) ---
# providers: openai | anthropic | fake   (fake = offline dev/tests)
LLM_CHAIN=openai:gpt-4o-mini,anthropic:claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# --- embeddings: openai | fake (fake = deterministic bag-of-words, no API needed) ---
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# --- ingestion / retrieval knobs (these are what the eval harness compares) ---
CHUNK_STRATEGY=structure        # fixed | sentence | structure
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_MODE=hybrid           # vector | keyword | hybrid
TOP_K=6
CANDIDATE_K=30
MAX_CONTEXT_CHARS=12000

# --- limits ---
MAX_UPLOAD_MB=25
DEFAULT_DAILY_TOKEN_QUOTA=200000
DEFAULT_MAX_DOCUMENTS=50
